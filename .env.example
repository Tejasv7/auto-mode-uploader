# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Video Settings
VIDEO_ORIENTATION=vertical
DEFAULT_LANGUAGE=hi

# Anti-Copyright Protection
ENABLE_ANTI_COPYRIGHT=true
SPEED_MULTIPLIER=1.04
COLOR_BOOST=true

# Storage Optimization (Auto delete local video after successful YouTube upload)
AUTO_DELETE_AFTER_UPLOAD=true

# Upload Schedule (Every 3 hours = 8 times daily)
UPLOAD_INTERVAL_HOURS=3
